generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  EXECUTIVE
  ADMIN
}

enum MembershipCategory {
  APPEARANCE
  NON_APPEARANCE
}

enum MembershipGrade {
  ACTIVE
  SILVER
  GOLDEN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum TransactionType {
  SAVINGS
  SHARE_PURCHASE
  DIVIDEND
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  DEVELOPMENT_LEVY
  REGISTRATION
}

enum LoanType {
  GENERAL
  PROPERTY
  COMMODITY
  BUSINESS
  EMERGENCY
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING
  APPROVED
  DISBURSED
  ACTIVE
  COMPLETED
  REJECTED
  DEFAULTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String
  dateOfBirth  DateTime?
  gender       String?
  address      String?
  state        String?
  localGovernment String?
  nationality  String?
  occupation   String?
  incomeRange  String?
  emergencyName String?
  emergencyPhone String?
  emergencyRelationship String?
  nomineeName  String?
  nomineePhone String?
  nomineeRelationship String?
  nomineeAddress String?
  passportPhoto String?
  identificationDocument String?
  termsAcceptedAt DateTime?
  role         Role      @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  membership   Membership?
  sessions     Session[]
  transactions Transaction[]
  loans        LoanApplication[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Membership {
  id           String             @id @default(cuid())
  userId       String             @unique
  category     MembershipCategory
  grade        MembershipGrade    @default(ACTIVE)
  status       MembershipStatus   @default(PENDING)
  membershipNo String             @unique
  weeklyTarget Float
  paymentSubmittedAt DateTime?
  joinedAt     DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares       ShareHolding[]
  shareTransactions ShareTransaction[]
}

model ShareHolding {
  id           String     @id @default(cuid())
  membershipId String
  units        Int        @default(0)
  unitPrice    Float
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model MembershipCategoryConfig {
  id                    String         @id @default(cuid())
  grade                 MembershipGrade @unique
  displayName           String
  durationYears         Int
  loanMultiplier        Float
  minMembershipMonths   Int
  minimumSavings        Float
  automaticClassification Boolean       @default(false)
  updatedBy             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model CooperativeSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  reference   String          @unique
  description String
  status      String          @default("POSTED")
  balanceAfter Float?
  actorId     String?
  reversedAt  DateTime?
  reversalOf  String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShareTransaction {
  id           String      @id @default(cuid())
  membershipId String
  units        Int
  unitPrice    Float
  type         String
  description  String
  reference    String      @unique
  actorId      String?
  createdAt    DateTime    @default(now())
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model LoanApplication {
  id                  String       @id @default(cuid())
  applicationNo       String       @unique @default(cuid())
  userId              String
  loanProductId       String?
  type                LoanType
  amount              Float
  purpose             String
  repaymentPeriod     Int?
  repaymentFrequency  String?
  processingFee       Float        @default(0)
  totalRepayment      Float?
  estimatedInstallment Float?
  status              LoanStatus   @default(SUBMITTED)
  guarantorName       String?
  guarantorPhone      String?
  guarantorAddress    String?
  guarantorRelationship String?
  propertyType        String?
  propertyLocation    String?
  propertyValue       Float?
  propertyDocuments   String?
  supportingDocuments String?
  documents           String?
  commodityItems      String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanProduct         LoanProduct? @relation(fields: [loanProductId], references: [id], onDelete: SetNull)
}

model LoanProduct {
  id                    String       @id @default(cuid())
  name                  String
  type                  LoanType     @unique
  maximumAmount        Float
  minimumAmount        Float
  processingFeeType    String       @default("PERCENTAGE")
  processingFeeValue   Float        @default(0)
  repaymentPeriod      Int
  repaymentFrequency   String       @default("MONTHLY")
  eligibilityRequirements String
  requiredSavings      Float        @default(0)
  requiredShares        Int          @default(0)
  guarantorRequirements String
  documentationRequirements String
  terms                String
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  applications          LoanApplication[]
}

model Commodity {
  id               String   @id @default(cuid())
  name             String
  description      String
  price            Float
  availableQuantity Int
  image            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}
