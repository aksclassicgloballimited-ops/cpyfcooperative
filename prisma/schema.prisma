generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  EXECUTIVE
  ADMIN
}

enum MembershipCategory {
  APPEARANCE
  NON_APPEARANCE
}

enum MembershipGrade {
  ACTIVE
  SILVER
  GOLDEN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum TransactionType {
  SAVINGS
  SHARE_PURCHASE
  DIVIDEND
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  DEVELOPMENT_LEVY
  REGISTRATION
}

enum LoanType {
  PROPERTY
  BUSINESS
  EMERGENCY
}

enum LoanStatus {
  PENDING
  APPROVED
  DISBURSED
  COMPLETED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String
  role         Role      @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  membership   Membership?
  sessions     Session[]
  transactions Transaction[]
  loans        LoanApplication[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Membership {
  id           String             @id @default(cuid())
  userId       String             @unique
  category     MembershipCategory
  grade        MembershipGrade    @default(ACTIVE)
  status       MembershipStatus   @default(PENDING)
  membershipNo String             @unique
  weeklyTarget Float
  joinedAt     DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares       ShareHolding[]
}

model ShareHolding {
  id           String     @id @default(cuid())
  membershipId String
  units        Int        @default(0)
  unitPrice    Float
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  reference   String          @unique
  description String
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoanApplication {
  id          String     @id @default(cuid())
  userId      String
  type        LoanType
  amount      Float
  purpose     String
  status      LoanStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}
