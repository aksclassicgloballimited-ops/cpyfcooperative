# Runtime URL. If using Supabase's pooler (port 6543), include pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL used by Prisma schema deployment.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://www.cpyfcooperative.com"
# Optional. Firebase service-account JSON for Android push delivery.
# Store the real value as a Vercel secret; do not commit credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional. Apple Push Notification service credentials for iOS push delivery.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="com.cpyif.cooperative"
APNS_USE_SANDBOX="false"

# Required: secret used to sign the cpyf_session JWT (min 32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
